--!strict
local History = require("@shared/History")
local T = require("@shared/Test")

local expect = T.expect

T.describe("History", function()
	T.it("undoes and redoes in order, with the step labels", function()
		local h = History.new()
		h:reset("a")
		h:push("b", "add b")
		h:push("c", "add c")
		expect(h:size()).toBe(2)
		expect(h:undoLabel()).toBe("add c")
		local state, label = h:undo()
		expect(state).toBe("b")
		expect(label).toBe("add c")
		state, label = h:undo()
		expect(state).toBe("a")
		expect(label).toBe("add b")
		expect(h:canUndo()).toBe(false)
		expect((h:undo())).toBeNil()
		expect(h:redoLabel()).toBe("add b")
		state, label = h:redo()
		expect(state).toBe("b")
		expect(label).toBe("add b")
		expect(h:current()).toBe("b")
	end)

	T.it("drops the redo branch on a new push", function()
		local h = History.new()
		h:reset(1)
		h:push(2)
		h:push(3)
		h:undo()
		h:undo()
		h:push(4, "other")
		expect(h:canRedo()).toBe(false)
		expect((h:redo())).toBeNil()
		expect((h:undo())).toBe(1)
	end)

	T.it("forgets the oldest steps past the limit", function()
		local h = History.new({ limit = 3 })
		h:reset(0)
		for i = 1, 10 do
			h:push(i)
		end
		expect(h:size()).toBe(3)
		expect((h:undo())).toBe(9)
		expect((h:undo())).toBe(8)
		expect((h:undo())).toBe(7)
		expect((h:undo())).toBeNil()
		expect(h:current()).toBe(7)
	end)

	T.it("ignores a push equal to the current state", function()
		local h = History.new({
			equals = function(a, b)
				return a.v == b.v
			end,
		})
		h:reset({ v = 1 })
		expect(h:push({ v = 1 })).toBe(false)
		expect(h:size()).toBe(0)
		expect(h:push({ v = 2 })).toBe(true)
		expect(h:size()).toBe(1)
	end)

	T.it("reset clears everything", function()
		local h = History.new()
		h:reset("a")
		h:push("b")
		h:reset("z")
		expect(h:canUndo()).toBe(false)
		expect(h:canRedo()).toBe(false)
		expect(h:current()).toBe("z")
	end)

	T.it("refuses a bad limit and a push before reset", function()
		expect(function()
			History.new({ limit = 0 })
		end).toThrow("limit")
		local h = History.new()
		expect(function()
			h:push("x")
		end).toThrow("reset")
	end)
end)
