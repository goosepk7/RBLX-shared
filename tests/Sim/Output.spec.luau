--!strict
local T = require("@shared/Test")
local Sim = require("@shared/Sim")
local expect = T.expect

T.describe("Sim.Stats", function()
	T.it("percentiles interpolate like numpy's default", function()
		local v = { 4, 1, 3, 2 }
		expect(Sim.Stats.percentile(v, 50)).toBe(2.5)
		expect(Sim.Stats.percentile(v, 0)).toBe(1)
		expect(Sim.Stats.percentile(v, 100)).toBe(4)
		expect(Sim.Stats.percentile(v, 25)).toBe(1.75)
		expect(v).toEqual({ 4, 1, 3, 2 }) -- input untouched
	end)

	T.it("summarize, histogram, shares", function()
		local s = Sim.Stats.summarize({ 1, 2, 3, 4, 5 })
		expect(s.count).toBe(5)
		expect(s.mean).toBe(3)
		expect(s.p50).toBe(3)
		expect(s.stddev).toBeNear(1.5811, 1e-4)
		expect(Sim.Stats.histogram({ -1, 0, 1, 5, 9, 50 }, { 0, 5, 10 })).toEqual({ 3, 3 })
		expect(Sim.Stats.shares({ a = 1, b = 3 })).toEqual({ a = 0.25, b = 0.75 })
		local empty = Sim.Stats.mean({})
		expect(empty ~= empty).toBe(true)
	end)
end)

T.describe("Sim.Json", function()
	T.it("encodes with sorted keys and stable numbers", function()
		local mixed: { any } = { 1, 2.5, "x" }
		local text = Sim.Json.encode({ b = 1, a = mixed, c = true, d = Sim.Json.object({}) })
		expect(text).toBe('{"a":[1,2.5,"x"],"b":1,"c":true,"d":{}}')
		expect(Sim.Json.encode('q"\n')).toBe('"q\\"\\n"')
		expect(Sim.Json.encode({})).toBe("[]")
	end)

	T.it("rejects NaN, infinity and cycles", function()
		expect(function()
			Sim.Json.encode({ x = 0 / 0 })
		end).toThrow("NaN")
		local cyclic: { [string]: any } = {}
		cyclic.self = cyclic
		expect(function()
			Sim.Json.encode(cyclic)
		end).toThrow("cyclic")
	end)

	T.it("pretty output is stable", function()
		expect(Sim.Json.encode({ a = { 1 } }, true)).toBe('{\n  "a": [\n    1\n  ]\n}')
	end)
end)

T.describe("Sim.Recorder", function()
	T.it("writes CSV with first-seen columns and escaping", function()
		local rec = Sim.Recorder.new()
		rec:row("income", { minute = 1, source = "challenge", amount = 2 })
		rec:row("income", { minute = 2, source = 'quote "x", y', amount = 2.5, bonus = true })
		expect(rec:csv("income")).toBe('amount,minute,source,bonus\n2,1,challenge,\n2.5,2,"quote ""x"", y",true\n')
	end)

	T.it("tracks metrics and counters and serializes to JSON", function()
		local rec = Sim.Recorder.new()
		rec:add("joins")
		rec:add("joins", 2)
		rec:set("p50", 41.5)
		expect(rec:get("joins")).toBe(3)
		expect(rec:json()).toBe('{"metrics":{"joins":3,"p50":41.5},"series":{}}')
	end)
end)

T.describe("Sim.Targets", function()
	T.it("passes and fails with readable lines", function()
		local t = Sim.Targets.new()
		expect(t:check("first win (s)", 42, { max = 60 })).toBe(true)
		expect(t:check("rebirth day", 5, { min = 2, max = 4 })).toBe(false)
		expect(t:check("nobody reached it", nil, { max = 10 })).toBe(false)
		expect(t:passed()).toBe(false)
		expect(#t:failures()).toBe(2)
		local lines = t:lines()
		expect(lines[1]).toBe("PASS  first win (s): 42 (target <= 60)")
		expect(lines[2]).toBe("FAIL  rebirth day: 5 (target 2..4)")
		expect(lines[3]).toBe("FAIL  nobody reached it: n/a (target <= 10)")
		expect(t:markdown()).toContain("**FAIL**")
	end)
end)
