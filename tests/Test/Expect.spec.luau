--!strict
local T = require("@shared/Test")
local expect = T.expect

T.describe("Test.Expect", function()
	T.it("toBe compares by identity", function()
		expect(1).toBe(1)
		expect("a").never.toBe("b")
	end)

	T.it("toEqual compares deeply and reports the differing path", function()
		expect({ a = { b = 1 } }).toEqual({ a = { b = 1 } })
		expect(function()
			expect({ a = { b = 1 } }).toEqual({ a = { b = 2 } })
		end).toThrow("value.a.b")
		expect(function()
			expect({ a = 1, extra = true }).toEqual({ a = 1 })
		end).toThrow("unexpected key")
	end)

	T.it("toBeNear uses an epsilon", function()
		expect(0.1 + 0.2).toBeNear(0.3)
		expect(1).never.toBeNear(1.1, 0.05)
	end)

	T.it("comparison and containment matchers", function()
		expect(5).toBeGreaterThan(4)
		expect(5).toBeLessThanOrEqual(5)
		expect({ 1, 2, 3 }).toContain(2)
		expect({ { id = 1 } }).toContain({ id = 1 })
		expect("hello world").toContain("o w")
		expect({ 1, 2 }).toHaveLength(2)
		expect("abc123").toMatch("%d+$")
		expect(nil).toBeNil()
		expect(false).toBeFalsy()
		expect("x").toBeType("string")
	end)

	T.it("toThrow checks the message substring", function()
		expect(function()
			error("502: boom")
		end).toThrow("502")
		expect(function() end).never.toThrow()
		expect(function()
			expect(function()
				error("other")
			end).toThrow("502")
		end).toThrow("but it threw")
	end)
end)

T.describe("Test runner hooks", function()
	local log: { string } = {}
	T.beforeEach(function()
		table.insert(log, "before")
	end)
	T.afterEach(function()
		table.insert(log, "after")
	end)

	T.it("runs beforeEach before the case", function()
		expect(log[#log]).toBe("before")
	end)

	T.it("runs afterEach after the previous case", function()
		expect(log).toEqual({ "before", "after", "before" })
	end)
end)
