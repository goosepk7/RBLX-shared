--!strict
local Format = require("@shared/UI/Format")
local T = require("@shared/Test")
local expect = T.expect

T.describe("UI.Format", function()
	T.it("compacts large numbers without rounding up", function()
		expect(Format.compact(0)).toBe("0")
		expect(Format.compact(950)).toBe("950")
		expect(Format.compact(1000)).toBe("1K")
		expect(Format.compact(1234)).toBe("1.2K")
		expect(Format.compact(1299)).toBe("1.2K")
		expect(Format.compact(12345)).toBe("12.3K")
		expect(Format.compact(123456)).toBe("123K")
		expect(Format.compact(999999)).toBe("999K")
		expect(Format.compact(3_400_000)).toBe("3.4M")
		expect(Format.compact(10_000_000_000)).toBe("10B")
		expect(Format.compact(-1500)).toBe("-1.5K")
	end)

	T.it("treats NaN as zero", function()
		expect(Format.compact(0 / 0)).toBe("0")
	end)

	T.it("groups thousands", function()
		expect(Format.grouped(7)).toBe("7")
		expect(Format.grouped(1234567)).toBe("1,234,567")
		expect(Format.grouped(-1000)).toBe("-1,000")
		expect(Format.grouped(100)).toBe("100")
	end)

	T.it("formats deltas with a sign", function()
		expect(Format.delta(12)).toBe("+12")
		expect(Format.delta(2500)).toBe("+2.5K")
		expect(Format.delta(-40)).toBe("-40")
	end)

	T.it("flags gains of at least 10% as big (NumberPop confetti rule)", function()
		expect(Format.isBigGain(100, 10, 0.1)).toBe(true)
		expect(Format.isBigGain(100, 9, 0.1)).toBe(false)
		expect(Format.isBigGain(0, 1, 0.1)).toBe(true)
		expect(Format.isBigGain(100, 0, 0.1)).toBe(false)
		expect(Format.isBigGain(100, -50, 0.1)).toBe(false)
	end)
end)
